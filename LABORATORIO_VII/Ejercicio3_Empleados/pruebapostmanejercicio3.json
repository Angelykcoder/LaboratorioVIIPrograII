{
  "info": {
    "name": "Ejercicio 3 - API de Empleados",
    "description": "Pruebas de operaciones, validaciones y API Key del ejercicio de empleados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "apiKey",
      "value": "clave-empleados-local"
    },
    {
      "key": "empleadoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Crear empleado (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 201 Created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('empleadoId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Garcia\",\n  \"correo\": \"carlos@example.com\",\n  \"especialidad\": \"Sistemas\",\n  \"estado\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/empleados"
      }
    },
    {
      "name": "Listar empleados (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200 OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/empleados"
      }
    },
    {
      "name": "Filtrar por especialidad (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Todos tienen especialidad Sistemas', function () { pm.response.json().forEach(e => pm.expect(e.especialidad.toLowerCase()).to.eql('sistemas')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/empleados?especialidad=Sistemas"
      }
    },
    {
      "name": "Obtener por ID existente (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200 OK', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/empleados/{{empleadoId}}"
      }
    },
    {
      "name": "Obtener ID inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 404 Not Found', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/empleados/999999"
      }
    },
    {
      "name": "Validación de campos vacíos (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"apellido\": \"\",\n  \"correo\": \"carlos@example.com\",\n  \"especialidad\": \"Sistemas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/empleados"
      }
    },
    {
      "name": "Validación de correo inválido (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 400 Bad Request', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Garcia\",\n  \"correo\": \"correo-invalido\",\n  \"especialidad\": \"Sistemas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/empleados"
      }
    },
    {
      "name": "API Key correcta (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK con API Key correcta', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/empleados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "empleados"
          ]
        }
      }
    },
    {
      "name": "Sin API Key (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/empleados"
      }
    },
    {
      "name": "API Key incorrecta (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "clave-incorrecta"
          }
        ],
        "url": "{{baseUrl}}/api/empleados"
      }
    }
  ]
}