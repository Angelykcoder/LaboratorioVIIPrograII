{
  "info": {
    "name": "Laboratorio VII - Ejercicio 1 Profesores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "apiKey",
      "value": "clave-desarrollo-profesores"
    },
    {
      "key": "profesorId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Crear profesor (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"profesorId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/profesores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profesores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"López\",\n  \"correo\": \"ana@correo.com\",\n  \"especialidad\": \"Matemática\",\n  \"estado\": true\n}"
        }
      }
    },
